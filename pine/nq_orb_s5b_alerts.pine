//@version=6
// =============================================================================
// NQ ORB + S5b — MANUAL TRADING ALERTS  (v1-alerts, r1)
// =============================================================================
// PURPOSE: phone notifications for a HUMAN trading the frozen NQ ORB + S5b
// strategy by hand. No webhook, no broker, no executor, no JSON.
//
// The strategy logic below is a byte-for-byte port of the audited
// `pine/nq_orb_s5b_v1.pine` sections B, C and D. Nothing is added, removed,
// re-timed or reinterpreted. Only the OUTPUT differs: human-readable alert text
// instead of machine payloads.
//
// WHY AN INDICATOR AND NOT A STRATEGY
//   * A strategy carries Strategy Properties — order execution, capital,
//     pyramiding, calc-on-every-tick — that a user can change without changing
//     the script, and TradingView snapshots them into the alert. An indicator
//     has none of that surface.
//   * Every price this script reports (entry, stop, exit) is computed by its
//     own state machine, exactly as the frozen research engines compute them.
//     None of them came from the broker emulator even in the strategy version.
//   * Keep `pine/nq_orb_s5b_v1.pine` for backtesting and parity. This file is
//     for the phone.
//
// ALERT TIMING — the one thing that matters for manual trading
//   The audited strategy emits its entry alert at the CLOSE of the entry bar,
//   which is five minutes after the price you are supposed to get. That is fine
//   for a machine reconciling afterwards and useless for a human.
//   Here the entry decision is evaluated on the entry bar's OPEN, which is
//   fixed from that bar's first tick, so the push arrives within seconds of the
//   moment the reference trade begins. The DECISION INPUTS are identical — the
//   frozen rule already reads only the bar's open — so this changes when you
//   are told, never what is decided.
//   The stop is detected the moment price touches it, for the same reason: a
//   bar's low is <= the stop intrabar exactly when it is <= the stop at close.
//
// CHART REQUIREMENTS — parity depends on all four
//   symbol    : NQ1!   (CME_MINI)
//   timeframe : 5 minutes
//   session   : Regular trading hours
//   chart type: standard candles (NOT Heikin-Ashi / Renko / Range / Kagi)
//   A red CONFIG ERROR label appears on the chart if any of these is wrong.
// =============================================================================

indicator("NQ ORB + S5b ALERTS", shorttitle = "NQ_ALERTS", overlay = true,
     max_labels_count = 500)

// -----------------------------------------------------------------------------
// Frozen constants — identical to nq_orb_s5b_v1.pine. NOT inputs, on purpose.
// -----------------------------------------------------------------------------
TZ              = "America/New_York"
BODY_FILTER     = 0.50      // B: body / full range >= 0.50
OR_OPEN_MIN     = 570       // B: 09:30 in NY minutes-of-day
OR_END_MIN      = 585       // B: opening range ends 09:44:59
QUAL_START_MIN  = 585       // B: qualification window 09:45 ..
QUAL_END_MIN    = 630       // .. 10:30 inclusive (bar OPEN time)
OB_END_MIN      = 600       // C: S5b opening balance 09:30-09:59
LATCH_FROM_MIN  = 600       // C: latch scan starts with the 10:00 bar
S5B_DEADLINE    = 690       // C: classifier stops after the 11:30 bar
BAND_LO         = 0.25      // C.4
BAND_HI         = 0.75      // C.4
INVALID_RETR    = 1.00      // C.5
FAIL_TOL        = 1.0       // C.6
VOL_MULT        = 1.2       // C.7
VOL_LEN         = 12        // C.7
VOL_MIN_OBS     = 6         // C.7
FINAL_BAR_MIN   = 955       // 15:55 NY — the reference's last bar

showOR    = input.bool(true, "Show ORH / ORL lines")
showHud   = input.bool(true, "Show status panel")
testFire  = input.bool(false, "SEND TEST ALERT (turn on to prove delivery)")

// =============================================================================
// SESSION FRAME
// =============================================================================
nyMinute      = hour(time, TZ) * 60 + minute(time, TZ)
nyDate        = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
isNewSession  = nyDate != nz(nyDate[1], -1)
isSessionLast = nyMinute >= FINAL_BAR_MIN or session.islastbar_regular
inRth         = nyMinute >= OR_OPEN_MIN and nyMinute < 960

f_px(float v) => na(v) ? "n/a" : str.tostring(v, format.mintick)

// =============================================================================
// SECTION B — ORB
// =============================================================================
var float orH          = na
var float orL          = na
var bool  orLocked     = false
var int   orBarCount   = 0
var int   orbSide      = 0          // 0 none, 1 long, -1 short
var int   signalBarTs  = na
var bool  pendingEntry = false
var bool  tradeTaken   = false      // B: one trade per day
var bool  daySettled   = false
var float entryPx      = na
var float stopPx       = na
var float exitPx       = na
var string exitReason  = ""
var bool  summarySent  = false

if isNewSession
    orH          := na
    orL          := na
    orLocked     := false
    orBarCount   := 0
    orbSide      := 0
    signalBarTs  := na
    pendingEntry := false
    tradeTaken   := false
    daySettled   := false
    entryPx      := na
    stopPx       := na
    exitPx       := na
    exitReason   := ""
    summarySent  := false

inOrWindow   = nyMinute >= OR_OPEN_MIN and nyMinute <  OR_END_MIN
inQualWindow = nyMinute >= QUAL_START_MIN and nyMinute <= QUAL_END_MIN

// --- opening range 09:30:00 - 09:44:59 (B) -----------------------------------
if inOrWindow and barstate.isconfirmed
    orH        := na(orH) ? high : math.max(orH, high)
    orL        := na(orL) ? low  : math.min(orL, low)
    orBarCount += 1
if not inOrWindow and nyMinute >= OR_END_MIN and orBarCount > 0
    orLocked := true

// B: body / full range >= 0.50. A zero-range bar has an undefined body fraction
// and can never qualify.
barRange     = high - low
bodyFrac     = barRange > 0 ? math.abs(close - open) / barRange : na
bodyQualifies= not na(bodyFrac) and bodyFrac >= BODY_FILTER
orReady      = orLocked and orBarCount >= 3 and not na(orH) and not na(orL)

longBreak    = orReady and bodyQualifies and close > orH
shortBreak   = orReady and bodyQualifies and close < orL

// B: first qualified direction wins; the session is finished once the first
// qualified signal has been taken, skipped or abandoned.
if barstate.isconfirmed and inQualWindow and orbSide == 0 and not tradeTaken and not pendingEntry and not daySettled
    if longBreak
        orbSide      := 1
        signalBarTs  := time
        pendingEntry := true
    else if shortBreak
        orbSide      := -1
        signalBarTs  := time
        pendingEntry := true

// --- entry on the next 5m bar open (B) ---------------------------------------
// The research engines skip the trade when the bar exactly 5 minutes after the
// signal bar is missing from the data.
barIsNextAfterSignal = pendingEntry and not na(signalBarTs) and (time - signalBarTs) == 300000

// `time > signalBarTs` is LOAD-BEARING. Pine runs the whole script top to bottom
// on every bar, so `pendingEntry` — set a few lines above on the signal bar — is
// already true when execution reaches here ON THAT SAME BAR. Without this guard
// the block runs on the signal bar, sees a 0ms difference instead of 300000, and
// abandons the trade it just armed. That was the v1.0-v1.2 zero-trade bug.
//
// Note this is NOT gated on `barstate.isconfirmed`, unlike the audited strategy:
// the decision reads only the bar's OPEN, which is fixed from the first tick, so
// evaluating it live gives the same answer five minutes sooner. That is the
// whole point of this file.
newEntry = false
newSkip  = false
if pendingEntry and not na(signalBarTs) and time > signalBarTs
    if barIsNextAfterSignal
        candidateEntry = open
        candidateStop  = orbSide == 1 ? orL : orH
        // B: "If next-bar entry is already beyond the stop/invalidation, SKIP."
        skip = (orbSide ==  1 and candidateEntry <= candidateStop) or
               (orbSide == -1 and candidateEntry >= candidateStop) or
               math.abs(candidateEntry - candidateStop) <= 0
        if skip
            orbSide      := 0
            pendingEntry := false
            daySettled   := true
            newSkip      := true
        else
            entryPx      := candidateEntry
            stopPx       := candidateStop
            pendingEntry := false
            tradeTaken   := true
            newEntry     := true
    else
        // Gap where the entry bar should have been: no trade this session.
        orbSide      := 0
        pendingEntry := false
        daySettled   := true
        newSkip      := true

// --- management: hard stop has priority, otherwise RTH close (B) -------------
// The stop is live from the entry bar onward, including the entry bar itself.
// lint:same-bar-ok — `tradeTaken` is set above ON THE ENTRY BAR and this block
// MUST see it on that same bar. The canonical list contains 8 sessions whose
// stop resolves on the entry bar itself; a bar-advance guard here would miss
// every one of them. This is the opposite of the zero-trade bug: there the
// same-bar read cancelled a live order, here it is the frozen rule.
stopHit = tradeTaken and not daySettled and not na(stopPx) and
          (orbSide == 1 ? low <= stopPx : high >= stopPx)

newStop  = false
newClose = false
// lint:same-bar-ok — see the note above: the stop is live on the entry bar.
if tradeTaken and not daySettled
    if stopHit
        exitPx     := stopPx                    // B: fill at the stop price
        exitReason := "ORB_STOP"
        daySettled := true
        newStop    := true
    else if isSessionLast and barstate.isconfirmed
        exitPx     := close                     // B: exit at RTH close
        exitReason := "SESSION_CLOSE_EXIT"
        daySettled := true
        newClose   := true

// =============================================================================
// SECTION C — S5b classifier (state only; never trades in v1)
// =============================================================================
var float obH        = na
var float obL        = na
var int   obBars     = 0
var int   s5bSide    = 0
var int   s5bStateN  = 0    // 0 WAITING 1 LATCHED 2 PULLBACK 3 FAILURE 4 CONFIRMED 5 INVALID
var float legHigh    = na
var float legLow     = na
var bool  pullActive = false
var int   sessionIdx = 0
var int   failureTs  = na
var bool  s5bDone    = false
var float sessHigh   = na
var float sessLow    = na
var float volSum     = 0.0
var int   volN       = 0

if isNewSession
    volSum     := 0.0
    volN       := 0
    obH        := na
    obL        := na
    obBars     := 0
    s5bSide    := 0
    s5bStateN  := 0
    legHigh    := na
    legLow     := na
    pullActive := false
    sessionIdx := 0
    failureTs  := na
    s5bDone    := false
    sessHigh   := na
    sessLow    := na

if barstate.isconfirmed and inRth
    sessionIdx += 1
    sessHigh   := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow    := na(sessLow)  ? low  : math.min(sessLow,  low)

// C: opening balance = first six 5m bars, 09:30-09:59.
if barstate.isconfirmed and inRth and nyMinute < OB_END_MIN
    obH    := na(obH) ? high : math.max(obH, high)
    obL    := na(obL) ? low  : math.min(obL, low)
    obBars += 1

// C.7: rolling 12-bar mean volume, session-scoped, minimum 6 observations,
// current bar included. The window never reaches into the previous session.
float volMean = na
if barstate.isconfirmed and inRth
    volSum := volSum + volume
    volN   := volN + 1
    if volN > VOL_LEN
        volSum := volSum - nz(volume[VOL_LEN])
        volN   := VOL_LEN
    volMean := volN >= VOL_MIN_OBS ? volSum / volN : na

obReady = obBars >= 6 and not na(obH) and not na(obL)

newS5b = false
// C: the classifier runs from the 10:00 bar through the 11:30 bar inclusive.
if barstate.isconfirmed and inRth and obReady and not s5bDone and nyMinute >= LATCH_FROM_MIN and nyMinute <= S5B_DEADLINE
    if s5bSide == 0
        // C: first close beyond OBH/OBL latches direction; first one wins.
        if close > obH
            s5bSide := 1
        else if close < obL
            s5bSide := -1
        if s5bSide != 0
            s5bStateN := 1
            // C.1/C.2: leg extremes = session extremes through the latch bar.
            legLow    := sessLow
            legHigh   := sessHigh
    else
        if s5bSide == 1
            legHigh := math.max(legHigh, high)
        else
            legLow  := math.min(legLow, low)
        leg = legHigh - legLow
        if leg > 0
            // C.3: retracement of the developing leg.
            retr = s5bSide == 1 ? (legHigh - low) / leg : (high - legLow) / leg
            if retr > INVALID_RETR
                // C.5: invalidates the S5b STATE only — never an ORB exit.
                s5bStateN := 5
                s5bDone   := true
            else
                // C.4: valid pullback when the retracement is 25%-75%.
                inBand = retr >= BAND_LO and retr <= BAND_HI
                if inBand and not pullActive
                    pullActive := true
                    s5bStateN  := 2
                // The band is a LIVE condition on the failure and reassertion
                // bars, not a latch that stays set once touched.
                // lint:same-bar-ok — the sequence may legitimately complete on
                // the same bar the pullback opens.
                if pullActive and inBand and sessionIdx >= 3
                    // C.6: two consecutive bars with no meaningful new progress.
                    failCond = s5bSide == 1 ?
                         (low  >= low[1]  - FAIL_TOL and low[1]  >= low[2]  - FAIL_TOL) :
                         (high <= high[1] + FAIL_TOL and high[1] <= high[2] + FAIL_TOL)
                    // C.7: reassertion / pressure bar.
                    resume = s5bSide == 1 ?
                         (close > high[1] and close > open) :
                         (close < low[1]  and close < open)
                    pressure = not na(volMean) and volume >= VOL_MULT * volMean
                    if failCond and na(failureTs)
                        failureTs := time
                        if s5bStateN == 2
                            s5bStateN := 3
                    if failCond and resume and pressure
                        // C.8: pullback + failure + reassertion => CONFIRMED.
                        s5bStateN := 4
                        s5bDone   := true
                        newS5b    := true

s5bStateStr = s5bStateN == 0 ? "WAITING" :
              s5bStateN == 1 ? "LATCHED" :
              s5bStateN == 2 ? "PULLBACK" :
              s5bStateN == 3 ? "FAILURE" :
              s5bStateN == 4 ? "CONFIRMED" : "INVALIDATED"
orbDirStr   = orbSide == 1 ? "LONG" : orbSide == -1 ? "SHORT" : "NONE"

// =============================================================================
// SECTION D — alignment. S5b NEVER retroactively filters the ORB entry.
// =============================================================================
aligned = s5bStateN == 4 and orbSide != 0 and s5bSide == orbSide

// =============================================================================
// ALERTS — human-readable, one TradingView alert covers all seven
// =============================================================================
lines  = "\n"
hdr    = "\n\nRULE:\nOne trade today. Do not chase if price has materially " +
         "moved from the stated entry."

// 1 / 2 — ORB entry, fired at the entry bar's OPEN
// lint:same-bar-ok — `newEntry`, `newStop`, `newClose` and `newS5b` are
// single-bar EDGE flags. They exist precisely to be read on the bar that sets
// them; that is what makes an alert fire once, at the moment of the event,
// instead of on every subsequent bar. They gate no strategy decision.
// lint:same-bar-ok — edge flag
if newEntry and orbSide == 1
    alert("\U0001F6A8 NQ LONG" + lines +
          "\nENTRY: "   + f_px(entryPx) +
          "\nSTOP: "    + f_px(stopPx) +
          "\nOR HIGH: " + f_px(orH) +
          "\nOR LOW: "  + f_px(orL) +
          "\n\nSTATUS:\nORB LONG CONFIRMED" + hdr, alert.freq_once_per_bar)
// lint:same-bar-ok — edge flag
if newEntry and orbSide == -1
    alert("\U0001F6A8 NQ SHORT" + lines +
          "\nENTRY: "   + f_px(entryPx) +
          "\nSTOP: "    + f_px(stopPx) +
          "\nOR HIGH: " + f_px(orH) +
          "\nOR LOW: "  + f_px(orL) +
          "\n\nSTATUS:\nORB SHORT CONFIRMED" + hdr, alert.freq_once_per_bar)

// 3 / 4 — S5b conviction on an ALIGNED existing ORB position. Context, not entry.
// lint:same-bar-ok — edge flag, see above.
if newS5b and aligned and s5bSide == 1
    alert("\U0001F525 HIGH CONVICTION LONG" + lines +
          "\nORB POSITION: LONG" +
          "\nS5b: CONFIRMED LONG" +
          "\n\nFailed counterattack sequence completed." +
          "\nBuyers have reasserted control." +
          "\n\nTHIS IS NOT A NEW ENTRY SIGNAL IN v1." +
          "\nIt is conviction/context for the existing ORB trade.",
          alert.freq_once_per_bar)
// lint:same-bar-ok — edge flag
if newS5b and aligned and s5bSide == -1
    alert("\U0001F525 HIGH CONVICTION SHORT" + lines +
          "\nORB POSITION: SHORT" +
          "\nS5b: CONFIRMED SHORT" +
          "\n\nFailed counterattack sequence completed." +
          "\nSellers have reasserted control." +
          "\n\nTHIS IS NOT A NEW ENTRY SIGNAL IN v1." +
          "\nIt is conviction/context for the existing ORB trade.",
          alert.freq_once_per_bar)

// 5 — stop, fired the moment price touches it
// lint:same-bar-ok — edge flag, see above.
if newStop
    alert("\U0001F6D1 NQ TRADE STOPPED" + lines +
          "\nSIDE: "       + orbDirStr +
          "\nSTOP PRICE: " + f_px(exitPx) +
          "\n\nTRADE IS OVER." +
          "\nNO SECOND TRADE TODAY.", alert.freq_once_per_bar)

// 6 — session close exit
// lint:same-bar-ok — edge flag, see above.
if newClose
    alert("✅ NQ SESSION EXIT" + lines +
          "\nSIDE: " + orbDirStr +
          "\nEXIT: " + f_px(exitPx) +
          "\n\nTRADE IS OVER." +
          "\nNO SECOND TRADE TODAY.", alert.freq_once_per_bar)

// 7 — session finished with no qualified trade. Fires once, at the final bar.
if isSessionLast and barstate.isconfirmed and not summarySent
    summarySent := true
    if not tradeTaken
        alert("⚪ NQ — NO TRADE TODAY" + lines +
              "\nNo valid ORB setup completed." +
              "\nSession finished.", alert.freq_once_per_bar)

// TEST — proves the alert reaches the phone without waiting for a setup.
// Turn the input on, wait for one bar, confirm the push, turn it off.
if testFire and barstate.isconfirmed
    alert("\U0001F514 NQ ALERT TEST" + lines +
          "\nDelivery is working." +
          "\nSymbol: " + syminfo.ticker +
          "\nTimeframe: " + timeframe.period +
          "\n\nTurn OFF 'SEND TEST ALERT' in the script settings.",
          alert.freq_once_per_bar)

// =============================================================================
// CHART — minimal, and a loud refusal if the chart cannot produce parity
// =============================================================================
plot(showOR and orReady and inRth ? orH : na, "ORH", color.new(color.teal, 0),
     2, plot.style_linebr)
plot(showOR and orReady and inRth ? orL : na, "ORL", color.new(color.teal, 0),
     2, plot.style_linebr)
plot(tradeTaken and not na(stopPx) and inRth ? stopPx : na, "STOP",
     color.new(color.red, 0), 2, plot.style_linebr)
plot(tradeTaken and not na(entryPx) and inRth ? entryPx : na, "ENTRY",
     color.new(color.white, 0), 1, plot.style_linebr)

plotshape(newEntry and orbSide == 1,  "LONG entry",  shape.triangleup,
          location.belowbar, color.new(color.lime, 0), size = size.small)
plotshape(newEntry and orbSide == -1, "SHORT entry", shape.triangledown,
          location.abovebar, color.new(color.red, 0), size = size.small)
plotshape(newStop,  "stopped", shape.xcross, location.absolute,
          color.new(color.red, 0), size = size.tiny)

var int cEthBars = 0
if barstate.isconfirmed and (nyMinute >= 1080 or nyMinute < 540)
    cEthBars += 1

cfgBad = timeframe.period != "5" or not chart.is_standard or cEthBars > 0
if cfgBad and barstate.islast
    label.new(bar_index, high,
              "CONFIG ERROR\n" +
              (timeframe.period != "5" ?
                   "timeframe is " + timeframe.period + ", must be 5\n" : "") +
              (not chart.is_standard ?
                   "non-standard chart type — Heikin-Ashi / Renko / Range feed\n" +
                   "synthetic prices, so every level here is wrong\n" : "") +
              (cEthBars > 0 ?
                   "extended-hours chart (" + str.tostring(cEthBars) +
                   " overnight bars)\nset the session to Regular trading hours\n" : "") +
              "These alerts are NOT the tested strategy on this chart.",
              style = label.style_label_down, color = color.new(color.red, 0),
              textcolor = color.white, size = size.normal)

var table hud = table.new(position.top_right, 2, 6, border_width = 1)
if showHud and barstate.islast
    stateTxt = daySettled and exitReason != "" ?
                   (exitReason == "ORB_STOP" ? "STOPPED" : "CLOSED") :
               tradeTaken   ? "IN TRADE " + orbDirStr :
               pendingEntry ? "ARMED " + orbDirStr :
               daySettled   ? "NO TRADE" : "WAITING"
    table.cell(hud, 0, 0, "STATE",   text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 0, stateTxt,  text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 1, "ORH/ORL", text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 1, f_px(orH) + " / " + f_px(orL),
                                     text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 2, "ENTRY",   text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 2, f_px(entryPx), text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 3, "STOP",    text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 3, f_px(stopPx),  text_color = color.white, text_size = size.small)
    table.cell(hud, 0, 4, "S5b",     text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 4, s5bStateStr + (aligned ? " (ALIGNED)" : ""),
                                     text_color = aligned ? color.orange : color.white,
                                     text_size = size.small)
    table.cell(hud, 0, 5, "TEST",    text_color = color.gray,  text_size = size.small)
    table.cell(hud, 1, 5, testFire ? "ON — turn off" : "off",
                                     text_color = testFire ? color.orange : color.gray,
                                     text_size = size.small)
